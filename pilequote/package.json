{
  "name": "pilequote",
  "version": "0.1.0",
  "private": true,
  "description": "Instant photo quotes for junk removal companies",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "express": "5.3.0",
    "nodemailer": "10.3.1",
    "qrcode": "1.5.4",
    "stripe": "23.1.0"
  }
}
